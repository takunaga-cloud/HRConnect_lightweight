# Production Environment Variables Template
# Copy this to .env on your EC2 instance

# Project Base
PROJECT_NAME="HR-Connect Production"
SECRET_KEY="GENERATED_STRONG_SECRET_KEY"

# Authentication (Cognito)
COGNITO_USER_POOL_ID="ap-northeast-1_xxxxxxxxx"
COGNITO_CLIENT_ID="xxxxxxxxxxxxxxxxxxxxxxxxxx"
COGNITO_REGION="ap-northeast-1"

# Database (Aurora PostgreSQL)
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL="postgresql+asyncpg://admin:password@hrconnect-db.cluster-xxxxxxxx.ap-northeast-1.rds.amazonaws.com:5432/hrconnect"

# AWS Storage (S3)
AWS_ACCESS_KEY_ID="AKIAxxxxxxxxxxxxxxxx"
AWS_SECRET_ACCESS_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
AWS_S3_BUCKET="hr-connect-production-assets"
AWS_REGION="ap-northeast-1"

# Frontend
NEXT_PUBLIC_BACKEND_URL="https://api.yourdomain.com"
